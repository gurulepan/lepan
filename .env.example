# Telegram bot token (@BotFather)
BOT_API_KEY=

# OpenRouter API key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=

# Модель OpenRouter (по умолчанию openrouter/free)
# OPENROUTER_MODEL=openrouter/free

# Лимит шагов агента (tool → observe → …)
# MAX_TOOL_STEPS=5

# Лимит токенов ответа (важно: иначе OpenRouter резервирует до 65536)
# MAX_OUTPUT_TOKENS=1500

# --- 1С MCP (aprovodka) ---

# Адрес опубликованной базы 1С (веб-сервис, напр. http://host/base/ru_RU)
ONEC_BASE_URL=
ONEC_LOGIN=
ONEC_PASSWORD=

# Порт HTTP MCP-сервера
MCP_PORT=3000

# URL MCP-сервера (опционально; по умолчанию http://localhost:${MCP_PORT}/mcp)
# MCP_URL=

# Автозапуск MCP-сервера вместе с ботом (true/false)
MCP_AUTOSTART=true

# Write-safety: off | preview | approval
ONEC_WRITE_MODE=preview
